# PostgreSQL connection string. Keep this secret and set it only in the runtime environment.
DATABASE_URL=

# Bootstrap authentication for the MCP endpoint. Replace with OAuth before broad production use.
MCP_BEARER_TOKEN=

# Safety gate: write tools are exposed but refuse execution unless explicitly enabled.
WRITE_TOOLS_ENABLED=false

# Public hostnames allowed to reach the MCP server, comma-separated.
# Example: mcp.ibexhad.com,ibex-had-mcp.example.workers.dev
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

PORT=3000
NODE_ENV=development
